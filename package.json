{
  "name": "hydra-server",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --hot src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src tests scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.83",
    "@ai-sdk/openai": "4.0.117",
    "@ai-sdk/typesafe-ai": "3.0.40",
    "ai": "7.0.172",
    "drizzle-orm": "0.45.4",
    "expo-server-sdk": "8.0.0",
    "hono": "4.13.18",
    "jsonrepair": "3.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
