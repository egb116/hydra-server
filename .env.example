# Hydra server settings. Copy this file to .env and fill it in.
# Keep comments on their own line. Some .env parsers read a trailing comment as part of the value.

# Leave this as selfhost.
HYDRA_MODE=selfhost

# Required. Generate one with: openssl rand -hex 32
# It encrypts the Reddit sessions the server stores. Keep a copy, and don't change it later,
# or the stored sessions can't be read.
ENCRYPTION_KEY=replace_with_the_output_of_openssl_rand_hex_32

# To change ENCRYPTION_KEY without losing the stored sessions, put the old key here and the
# new one above. Separate several old keys with commas. After a day of uptime everything has
# been re-encrypted with the new key, and the old one can be removed.
# ENCRYPTION_KEYS_PREVIOUS=

# Password for the admin page at /admin. It needs at least 16 characters. The page stays off
# until you change it from this placeholder.
DASHBOARD_PASSWORD=your_secure_dashboard_password

# PORT=3000

# Where the database is stored. Docker uses /data/sqlite.db. Without Docker it's ./sqlite.db.
# Backups are written to the same folder.
# DATABASE_PATH=

# debug, info, warn or error.
# LOG_LEVEL=info

# Set this to 1 if the server sits behind a reverse proxy like nginx or Caddy (or to the number
# of proxies in front of it). Otherwise rate limits see every request as coming from the proxy.
# TRUST_PROXY=none

# --- AI features ---

# groq or openai. Use openai for OpenAI itself or any OpenAI-compatible API.
AI_PROVIDER=groq

# Needed when AI_PROVIDER is groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Needed when AI_PROVIDER is openai. The in-app guide search always uses OpenAI, so it only
# works with this key set.
# OPENAI_API_KEY=

# Use AI_PROVIDER=openai with a different server, such as a model running locally.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. A TypeSafe AI key (https://typesafe.ai). With it, post filtering uses their Jev
# model, which scores each post and follows the app's filter sensitivity setting. Without it,
# post filtering uses AI_PROVIDER like the other features.
# TYPESAFE_AI_API_KEY=

# Pick your own models instead of the defaults.
# AI_MODEL_SUMMARY=
# AI_MODEL_FILTER=
# AI_MODEL_ANSWER=

# The most the in-app guide (questions and search) can spend per day, in US dollars.
# It resets at midnight UTC. 0 turns the guide's AI off.
# AI_FREE_DAILY_BUDGET_USD=5

# --- Reddit and notifications ---

# How often each inbox is checked, in milliseconds. The default is 2 minutes.
# POLL_INTERVAL_MS=120000

# How many inboxes can be checked at the same time.
# POLL_CONCURRENCY=32

# A Webshare API token. With it, Reddit requests go through Webshare proxies instead of your
# own IP address.
# WEBSHARE_TOKEN=

# A Discord webhook URL. The server posts there when something goes wrong.
# DISCORD_WEBHOOK_URL=
